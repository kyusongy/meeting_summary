# Password required to open the app. The deployment sits on a public URL in
# front of paid API keys, so the app refuses to serve anything without this.
APP_PASSWORD=

# Deepgram API key for speech-to-text transcription
# Get one at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Any OpenAI-compatible LLM provider for summarization
# Examples:
#   OpenRouter: https://openrouter.ai/api/v1
#   OpenAI:     https://api.openai.com/v1
#   Ollama:     http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash
